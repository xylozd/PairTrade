# NSE Intraday Pair Trading — environment template
#
# Copy to `.env` and fill in real values:
#     cp .env.example .env
#
# `.env` is gitignored. NEVER commit a filled-in copy of this file.
# Every value below is a placeholder.

# --- Application ---------------------------------------------------------
PAIRTRADE_ENVIRONMENT=dev
PAIRTRADE_LOG_LEVEL=INFO
PAIRTRADE_API_HOST=0.0.0.0
PAIRTRADE_API_PORT=8000
# Comma-separated list of allowed browser origins.
PAIRTRADE_CORS_ORIGINS=["http://localhost:5173"]

# --- Database ------------------------------------------------------------
# Matches the POSTGRES_* values below.
PAIRTRADE_DATABASE_URL=postgresql+asyncpg://pairtrade:pairtrade@localhost:5432/pairtrade

# --- Redis ---------------------------------------------------------------
PAIRTRADE_REDIS_URL=redis://localhost:6379/0

# --- Auth ----------------------------------------------------------------
# Generate a real secret: python -c "import secrets; print(secrets.token_urlsafe(48))"
PAIRTRADE_JWT_SECRET_KEY=change-me
PAIRTRADE_ACCESS_TOKEN_TTL_MINUTES=15
PAIRTRADE_REFRESH_TOKEN_TTL_DAYS=7

# --- Local services (read by docker-compose.yml) -------------------------
POSTGRES_USER=pairtrade
POSTGRES_PASSWORD=change-me
POSTGRES_DB=pairtrade
POSTGRES_PORT=5432
REDIS_PORT=6379
